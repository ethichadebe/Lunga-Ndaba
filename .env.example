# Copy to /opt/lunga-ndaba/.env on the server and fill in. Never commit the real file.

# Set by the deploy at cutover; leave as they are.
BACKEND_IMAGE=
FRONTEND_IMAGE=

# Where nginx on the host reaches the site, e.g. 127.0.0.1:<port>.
# Not 13004 or 18085: those are the deploy's candidate ports.
FRONTEND_PORT=

POSTGRES_DB=lunga
POSTGRES_USER=lunga
POSTGRES_PASSWORD=
# Same values as above, host "db".
DATABASE_URL=postgresql://lunga:<password>@db:5432/lunga

# The password Lunga signs in to /admin with.
ADMIN_PASSWORD=
# A long random string: openssl rand -hex 32
SESSION_SECRET=
